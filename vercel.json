{
  "functions": {
    "api/revert-ranges.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/revert-ranges",
      "schedule": "15 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/Revert Finance",
      "destination": "/revert",
      "permanent": true
    },
    {
      "source": "/Revert Finance/",
      "destination": "/revert/",
      "permanent": true
    },
    {
      "source": "/Revert Finance/:path*",
      "destination": "/revert/:path*",
      "permanent": true
    }
  ]
}
